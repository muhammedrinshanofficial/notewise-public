# Terraform local state and cache
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lambda build artifacts - regenerated from source, not tracked
lambdas/**/*.zip

# render_pdf: track only our own code and the dependency list, not the pip-installed libraries
lambdas/render_pdf/*
!lambdas/render_pdf/index.py
!lambdas/render_pdf/requirements.txt